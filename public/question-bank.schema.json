{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://chagok.local/question-bank.schema.json",
  "title": "차곡 문제은행 v1.0 · 고정 규격",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bank",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "bank": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "subject",
        "unit"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,100}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "\\S"
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "topic",
              "difficulty",
              "prompt",
              "explanation",
              "tags",
              "options",
              "answer"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,100}$"
              },
              "type": {
                "const": "multiple_choice"
              },
              "topic": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000,
                "pattern": "\\S"
              },
              "difficulty": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000,
                "pattern": "\\S"
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000,
                "pattern": "\\S"
              },
              "tags": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000,
                  "pattern": "\\S"
                }
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10000,
                      "pattern": "\\S"
                    }
                  }
                }
              },
              "answer": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "option_id"
                ],
                "properties": {
                  "option_id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{1,100}$"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "topic",
              "difficulty",
              "prompt",
              "explanation",
              "tags",
              "answer"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,100}$"
              },
              "type": {
                "const": "short_answer"
              },
              "topic": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000,
                "pattern": "\\S"
              },
              "difficulty": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000,
                "pattern": "\\S"
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000,
                "pattern": "\\S"
              },
              "tags": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000,
                  "pattern": "\\S"
                }
              },
              "answer": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "accepted"
                ],
                "properties": {
                  "accepted": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 30,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 10000,
                      "pattern": "\\S"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "topic",
              "difficulty",
              "prompt",
              "explanation",
              "tags",
              "answer"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]{1,100}$"
              },
              "type": {
                "const": "fill_blank"
              },
              "topic": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000,
                "pattern": "\\S"
              },
              "difficulty": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000,
                "pattern": "\\S"
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000,
                "pattern": "\\S"
              },
              "tags": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10000,
                  "pattern": "\\S"
                }
              },
              "answer": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "blanks"
                ],
                "properties": {
                  "blanks": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "id",
                        "accepted"
                      ],
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[1-9][0-9]*$"
                        },
                        "accepted": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 30,
                          "uniqueItems": true,
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 10000,
                            "pattern": "\\S"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
